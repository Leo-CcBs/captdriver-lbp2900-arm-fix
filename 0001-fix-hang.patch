+
 void capt_wait_ready(void)
 {
-	while (FLAG(capt_get_status(), CAPT_FL_BUSY))
+	unsigned wait_count = 0;
+	while (FLAG(capt_get_status(), CAPT_FL_BUSY)) {
+		if (++wait_count > CAPT_WAIT_READY_TIMEOUT) {
+			fprintf(stderr, "ERROR: CAPT: printer busy timeout after %u s\n", wait_count);
+			return;
+		}
 		sleep(1);
